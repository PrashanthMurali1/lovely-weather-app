# All settings are optional; values shown are the defaults from app/config.py.
# Copy to backend/.env (gitignored) or set as environment variables.

# SQLite cache file (relative to the backend working directory)
WEATHER_CACHE_PATH=data/weather.db
# Forecast cache lifetime (30 minutes)
WEATHER_FORECAST_TTL_SECONDS=1800
# Place-search cache lifetime (30 days)
WEATHER_SEARCH_TTL_SECONDS=2592000
# How long expired forecasts are kept to serve as stale fallback (24 hours)
WEATHER_STALE_RETENTION_SECONDS=86400
# Soft cap on upstream Open-Meteo calls per day (provider hard limit is 10,000)
WEATHER_DAILY_BUDGET_SOFT_LIMIT=8000
# Upstream request timeout in seconds
WEATHER_UPSTREAM_TIMEOUT_SECONDS=8.0
# After an upstream failure, skip upstream for the same key for this long
WEATHER_FAILURE_COOLDOWN_SECONDS=20
# CORS origins. This is a list, so pydantic-settings requires a JSON array.
WEATHER_ALLOWED_ORIGINS=["http://localhost:5173"]
